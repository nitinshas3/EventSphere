# EventSphere Frontend Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Base URL for the backend API.
# Leave blank to use Vite's dev-server proxy (/api -> http://localhost:8080)
# Set to an absolute URL (e.g. http://localhost:8080 or https://api.yourdomain.com) if calling directly
VITE_API_BASE_URL=

# Keycloak OIDC Configuration
VITE_KEYCLOAK_URL=http://localhost:9090
VITE_KEYCLOAK_REALM=event-ticket-platform
VITE_KEYCLOAK_CLIENT_ID=event-ticket-platform-app
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5173/callback
VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
